<Project Sdk="Microsoft.NET.Sdk">

    <Target Name="CopyDllAfterBuild" AfterTargets="Build">
        <ItemGroup>
            <DllFiles Include="$(TargetPath)"/>
            <DllFiles Include="@(ReferencePath)" Condition="'%(Filename)' == 'Newtonsoft.Json'"/>
        </ItemGroup>

        <Copy
                SourceFiles="@(DllFiles)"
                DestinationFolder="..\OutDll"
                SkipUnchangedFiles="true"
        />
    </Target>

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14.0</LangVersion>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="0Harmony">
        <HintPath>..\Lib\BepInEx\0Harmony.dll</HintPath>
      </Reference>
      <Reference Include="Assembly-CSharp">
        <HintPath>..\Lib\Game\Assembly-CSharp.dll</HintPath>
      </Reference>
      <Reference Include="BepInEx">
        <HintPath>..\Lib\BepInEx\BepInEx.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.CoreModule">
        <HintPath>..\Lib\Game\UnityEngine.CoreModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine">
        <HintPath>..\Lib\Game\UnityEngine.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="14.0.1-beta2" />
    </ItemGroup>

</Project>
